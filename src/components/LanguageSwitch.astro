---
// 001:T031 Language switch to the counterpart page (001:FR-008)
import { locales, type Locale } from '../i18n/ui.ts';
import { t } from '../i18n/utils.ts';
import { counterpartPath } from '../site/routes.ts';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const names: Record<Locale, string> = { en: 'English', nl: 'Nederlands' };
---

<nav aria-label={t(locale, 'lang.label')} data-spec="001:FR-008">
  <ul>
    {locales.map((l) => (
      <li>
        <a
          href={counterpartPath(path, l)}
          hreflang={l}
          lang={l}
          aria-current={l === locale ? 'true' : undefined}
        >
          <span aria-hidden="true">{l.toUpperCase()}</span>
          <span class="visually-hidden">{names[l]}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul {
    display: inline-flex;
    margin: 0;
    padding: 2px;
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-muted);
  }

  a {
    display: block;
    min-width: 2.75rem;
    padding: var(--space-1) var(--space-3);
    border-radius: calc(var(--radius) - 2px);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    line-height: 2;
  }

  a:hover {
    color: var(--color-text);
  }

  a[aria-current='true'] {
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }
</style>
