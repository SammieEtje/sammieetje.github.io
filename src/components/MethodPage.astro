---
// 004:T005 Method page body, shared by both languages (004:FR-001 – 004:FR-005)
import type { Locale } from '../i18n/ui.ts';
import { t } from '../i18n/utils.ts';
import {
  assumptions,
  models,
  complianceSteps,
  levers,
  phaseProofs,
  pragmatism,
  premise,
} from '../site/method.ts';
import { patterns } from '../site/patterns.ts';
import { releaseLabel } from '../site/period.ts';
import { routes } from '../site/routes.ts';
import PathDiagram from './PathDiagram.astro';
// 006:T006 Further reading on LinkedIn (006:FR-009)
import { articleById } from '../site/articles.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const two = (n: number) => String(n).padStart(2, '0');
const history = routes.find((r) => r.id === 'career')!.paths[locale];
const playground = routes.find((r) => r.id === 'playground')!.paths[locale];
const further = {
  premise: articleById('elite-sports'),
  levers: articleById('golden-cage'),
  assumptions: articleById('people-lazy'),
  community: articleById('community'),
};
---

<div class="method">
  <section class="premise" aria-labelledby="method-title" data-spec="004:FR-002">
    <div class="text">
      <p class="kind mono">golden-path template</p>
      <h1 id="method-title">{t(locale, 'method.heading')}</h1>
      <p class="principle">{premise.principle[locale]}</p>
      <p class="lead">{premise.premise[locale]}</p>
      <p class="diagnosis">{premise.diagnosis[locale]}</p>
      <p class="further" data-spec="006:FR-009">
        <span class="label mono">{t(locale, 'method.further')}</span>
        <a href={further.premise.url} lang="en" rel="noopener">
          {further.premise.title}
          <span class="visually-hidden" lang={locale}>
            {' '}
            {t(locale, 'writing.onLinkedIn')}
          </span>
        </a>
      </p>
      <!-- 008:T006 Invitation to the playground (008:FR-009) -->
      <p>
        <a class="try" href={playground} data-spec="008:FR-009">
          {t(locale, 'method.playground')}
          <span aria-hidden="true"> →</span>
        </a>
      </p>
    </div>
    <PathDiagram locale={locale} />
  </section>

  <section aria-labelledby="levers-title" data-spec="004:FR-004">
    <h2 id="levers-title">{t(locale, 'method.levers.title')}</h2>
    <div class="levers">
      {levers.map((lever) => (
        <article class={`lever ${lever.id}`} aria-labelledby={`lever-${lever.id}`}>
          <h3 id={`lever-${lever.id}`}>{lever.title[locale]}</h3>
          <ul>
            {lever.instruments.map((instrument) => (
              <li>{instrument[locale]}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="pragmatism">{pragmatism[locale]}</p>
    <p class="further" data-spec="006:FR-009">
      <span class="label mono">{t(locale, 'method.further')}</span>
      <a href={further.levers.url} lang="en" rel="noopener">
        {further.levers.title}
        <span class="visually-hidden" lang={locale}>
          {' '}
          {t(locale, 'writing.onLinkedIn')}
        </span>
      </a>
    </p>
  </section>

  <section aria-labelledby="assumptions-title" data-spec="004:FR-005">
    <h2 id="assumptions-title">{t(locale, 'method.assumptions.title')}</h2>
    <p class="intro">{t(locale, 'method.assumptions.intro')}</p>
    <ol class="assumptions">
      {assumptions.map((a, i) => (
        <li id={`assumption-${i + 1}`}>
          <span class="number mono" aria-hidden="true">
            {two(i + 1)}
          </span>
          <p class="statement">{a.statement[locale]}</p>
          {a.subtitle && <p class="subtitle">{a.subtitle[locale]}</p>}
          <p class="in-practice">
            <span class="label mono">{t(locale, 'method.inPractice')}</span>
            {a.inPractice[locale]}
          </p>
        </li>
      ))}
    </ol>
    <p class="further" data-spec="006:FR-009">
      <span class="label mono">{t(locale, 'method.further')}</span>
      <a href={further.assumptions.url} lang="en" rel="noopener">
        {further.assumptions.title}
        <span class="visually-hidden" lang={locale}>
          {' '}
          {t(locale, 'writing.onLinkedIn')}
        </span>
      </a>
    </p>
  </section>

  <!-- 004:T007 Phases linked to the releases that prove them (004:FR-006) -->
  <section aria-labelledby="phases-title" data-spec="004:FR-006">
    <h2 id="phases-title">{t(locale, 'method.phases.title')}</h2>
    <p class="intro">{t(locale, 'method.phases.intro')}</p>
    <ol class="phases">
      {patterns.map((phase) => (
        <li class={`phase phase-${phase.id}`}>
          <h3>{phase.name[locale]}</h3>
          <p>{phase.explanation[locale]}</p>
          <p class="label mono">{t(locale, 'method.proof')}</p>
          <ul class="proof">
            {phaseProofs(phase.id).map((r) => (
              <li>
                <a href={`${history}#release-${r.id}`}>
                  <span class="mono">{releaseLabel(r.start)}</span> {r.title[locale]},{' '}
                  {r.org[locale]}
                </a>
              </li>
            ))}
          </ul>
          {phase.id === 'community' && (
            <p class="further" data-spec="006:FR-009">
              <span class="label mono">{t(locale, 'method.further')}</span>
              <a href={further.community.url} lang="en" rel="noopener">
                {further.community.title}
                <span class="visually-hidden" lang={locale}>
                  {' '}
                  {t(locale, 'writing.onLinkedIn')}
                </span>
              </a>
            </p>
          )}
        </li>
      ))}
    </ol>
  </section>

  <!-- 004:T007 Compliance as a built-in platform property, as pipeline stages (004:FR-008) -->
  <section aria-labelledby="compliance-title" data-spec="004:FR-008">
    <h2 id="compliance-title">{t(locale, 'method.compliance.title')}</h2>
    <p class="intro">{t(locale, 'method.compliance.intro')}</p>
    <ol class="pipeline">
      {complianceSteps.map((step, i) => (
        <li>
          <span class="number mono" aria-hidden="true">
            {two(i + 1)}
          </span>
          <p>{step[locale]}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 004:T009 The behavioural science, as the page's dependencies (004:FR-009) -->
  <section aria-labelledby="deps-title" data-spec="004:FR-009">
    <h2 id="deps-title">{t(locale, 'method.deps.title')}</h2>
    <p class="intro">{t(locale, 'method.deps.intro')}</p>
    <ul class="deps">
      {models.map((m) => (
        <li>
          <code>{m.manifest}</code>
          <p class="name">{m.name[locale]}</p>
          <p class="authors">
            {m.authors}, {m.year}
          </p>
          <p class="takeaway">{m.takeaway[locale]}</p>
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  .method {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
  }

  section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  h2 {
    font-size: var(--text-xl);
  }

  .intro {
    color: var(--color-text-muted);
  }

  .premise {
    align-items: center;
    gap: var(--space-6);
  }

  .premise .text {
    display: grid;
    gap: var(--space-3);
  }

  .kind {
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(2rem, 1.6rem + 2vw, 2.75rem);
  }

  .principle {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-accent);
  }

  .lead {
    font-size: var(--text-lg);
  }

  .try {
    font-weight: 600;
  }

  .further {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
  }

  .further a::after {
    content: ' ↗';
  }

  .diagnosis {
    color: var(--color-text-muted);
    max-width: 62ch;
  }

  .levers {
    display: grid;
    gap: var(--space-4);
  }

  .lever {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 2);
  }

  .lever.lower {
    border-top: 4px solid var(--color-accent);
  }

  .lever.raise {
    border-top: 4px dashed var(--color-text-muted);
  }

  .lever h3 {
    font-size: var(--text-base);
  }

  .lever ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-6);
  }

  .lever.lower li::marker {
    content: '↓  ';
    color: var(--color-accent);
  }

  .lever.raise li::marker {
    content: '↑  ';
    color: var(--color-text-muted);
  }

  .pragmatism {
    padding: var(--space-4);
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .assumptions {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .assumptions li {
    /* 005:T006 Stable anchors for links from the README (005:FR-008) */
    scroll-margin-top: var(--space-6);
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 2);
  }

  .number {
    color: var(--color-accent);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .statement {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.3;
  }

  .subtitle {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .in-practice {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .label {
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .phases {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: phase;
  }

  .phase {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 2);
  }

  .phase h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
  }

  .phase h3::before {
    counter-increment: phase;
    content: counter(phase);
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-accent-soft);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .phase > p:not(.label) {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .proof {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .proof .mono {
    color: var(--color-text-muted);
  }

  .pipeline {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pipeline li {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
  }

  .deps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 2);
  }

  .deps li {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-6);
  }

  .deps li + li {
    border-top: 1px solid var(--color-border);
  }

  .deps code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    overflow-wrap: anywhere;
  }

  .deps .name {
    font-weight: 650;
  }

  .deps .authors {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .phases {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pipeline {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .levers,
    .assumptions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .premise {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
</style>
