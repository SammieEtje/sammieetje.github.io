---
// 002:T013 About card (002:FR-007)
import type { Locale } from '../i18n/ui.ts';
import { t } from '../i18n/utils.ts';
import PortalCard from './PortalCard.astro';
import { routes } from '../site/routes.ts';

interface Props {
  locale: Locale;
  class?: string | undefined;
}

const { locale, class: className } = Astro.props;
const method = routes.find((r) => r.id === 'method')!.paths[locale];
---

<PortalCard
  id="about-title"
  title={t(locale, 'card.about.title')}
  kind={t(locale, 'card.about.kind')}
  spec="002:FR-007"
  class={className}
>
  <p>{t(locale, 'about.body')}</p>
  <!-- 004:T011 Link to the method (004:FR-011) -->
  <a class="more" href={method} data-spec="004:FR-011">
    {t(locale, 'about.method')}
    <span aria-hidden="true"> →</span>
  </a>
</PortalCard>

<style>
  p {
    max-width: 68ch;
  }

  .more {
    justify-self: start;
    font-weight: 600;
    font-size: var(--text-sm);
  }
</style>
