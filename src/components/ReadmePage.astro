---
// 005:T004 Manager README rendered as API documentation (005:FR-001 – 005:FR-005, 005:FR-011)
import type { Locale } from '../i18n/ui.ts';
import { t } from '../i18n/utils.ts';
import { endpoints, knownIssues, readmeMeta, testimonial } from '../site/readme.ts';
import { routes } from '../site/routes.ts';
import { profile } from '../site/profile.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const method = routes.find((r) => r.id === 'method')!.paths[locale];
const updated = new Intl.DateTimeFormat(locale === 'nl' ? 'nl-NL' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${readmeMeta.updated}T00:00:00Z`));
---

<div class="readme">
  <header data-spec="005:FR-002">
    <p class="kind mono">openapi: sander-ettema</p>
    <h1>{t(locale, 'readme.heading')}</h1>
    <p class="intro">{readmeMeta.intro[locale]}</p>
    <p class="version mono">
      v{readmeMeta.updated.replaceAll('-', '.')} · {t(locale, 'readme.version')}{' '}
      <time datetime={readmeMeta.updated}>{updated}</time>
    </p>
  </header>

  <figure class="testimonial" data-spec="005:FR-011">
    <blockquote lang="en">
      <p>{testimonial.quote}</p>
    </blockquote>
    <figcaption>
      <a href={testimonial.url} rel="noopener">
        {testimonial.author}
      </a>
      , {testimonial.role[locale]}
    </figcaption>
  </figure>

  <nav aria-label={t(locale, 'readme.toc')} data-spec="005:FR-004">
    <ul class="toc">
      {endpoints.map((e) => (
        <li>
          <a href={`#endpoint-${e.id}`}>
            <span class={`method ${e.method.toLowerCase()}`}>{e.method}</span> <code>{e.path}</code>
            <span class="toc-title">{e.title[locale]}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {endpoints.map((e) => (
    <section
      id={`endpoint-${e.id}`}
      class="endpoint"
      data-spec="005:FR-003"
      aria-labelledby={`h-${e.id}`}
    >
      <h2 id={`h-${e.id}`}>
        <span class={`method ${e.method.toLowerCase()}`}>{e.method}</span> <code>{e.path}</code>{' '}
        <span class="title">{e.title[locale]}</span>
      </h2>
      <ul class="items">
        {e.items.map((item) => (
          <li>{item[locale]}</li>
        ))}
      </ul>
      {e.id === 'errors' && (
        // 005:T006 Link to the assumption behind it (005:FR-008)
        <a class="more" href={`${method}#assumption-2`} data-spec="005:FR-008">
          {t(locale, 'readme.errors.link')}
          <span aria-hidden="true"> →</span>
        </a>
      )}
      {e.id === 'known-issues' && (
        // 005:T006 Known issues with workarounds (005:FR-007)
        <div class="issues" data-spec="005:FR-007">
          {knownIssues.map((issue) => (
            <dl class="issue">
              <dt>{t(locale, 'readme.issue')}</dt>
              <dd>{issue.description[locale]}</dd>
              <dt>{t(locale, 'readme.workaround')}</dt>
              <dd>{issue.workaround[locale]}</dd>
            </dl>
          ))}
        </div>
      )}
    </section>
  ))}
  <!-- 005:T008 Call to action: LinkedIn, no form, no email (005:FR-009) -->
  <aside class="cta" aria-labelledby="cta-title" data-spec="005:FR-009">
    <h2 id="cta-title">{t(locale, 'readme.cta.title')}</h2>
    <p>{t(locale, 'readme.cta.body')}</p>
    <a class="button" href={profile.linkedin} rel="me noopener">
      {t(locale, 'readme.cta.button')}
      <span aria-hidden="true"> ↗</span>
    </a>
  </aside>
</div>

<style>
  .readme {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  header {
    display: grid;
    gap: var(--space-3);
  }

  .kind {
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(2rem, 1.6rem + 2vw, 2.75rem);
  }

  .intro {
    font-size: var(--text-lg);
    max-width: 62ch;
  }

  .version {
    color: var(--color-text-muted);
  }

  .testimonial {
    margin: 0;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 calc(var(--radius) * 2) calc(var(--radius) * 2) 0;
  }

  blockquote {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.45;
  }

  blockquote p::before {
    content: '“';
  }

  blockquote p::after {
    content: '”';
  }

  figcaption {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .toc {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-4);
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 2);
  }

  .toc a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
  }

  .toc a:hover {
    background: var(--color-surface-muted);
  }

  .toc-title {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  /* Method badges: the method is always written out; colour only reinforces it */
  .method {
    display: inline-block;
    min-width: 3.25rem;
    padding: 0 var(--space-2);
    border: 1.5px solid currentColor;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    text-align: center;
    letter-spacing: 0.04em;
    vertical-align: 0.15em;
  }

  .method.get {
    color: var(--color-text);
  }

  .method.post,
  .method.put {
    color: var(--color-accent);
  }

  .endpoint {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 2);
    scroll-margin-top: var(--space-6);
  }

  .endpoint:target {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-lg);
  }

  h2 code {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  h2 .title {
    flex-basis: 100%;
  }

  .cta {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-6);
    background: var(--color-accent-soft);
    border-radius: calc(var(--radius) * 2);
  }

  .button {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-weight: 600;
    text-decoration: none;
  }

  .more {
    justify-self: start;
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .issues {
    display: grid;
    gap: var(--space-3);
  }

  .issue {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: var(--space-4);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
  }

  .issue dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-top: 0.2em;
  }

  .issue dd {
    margin: 0;
  }

  .items {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-6);
    max-width: 68ch;
  }
</style>
