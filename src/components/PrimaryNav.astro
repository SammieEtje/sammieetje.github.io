---
// 001:T027 Navigation generated from the route registry (001:FR-004)
import type { Locale } from '../i18n/ui.ts';
import { t } from '../i18n/utils.ts';
import { navItems } from '../site/routes.ts';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const items = navItems(locale, path);
---

<nav aria-label={t(locale, 'nav.label')} data-spec="001:FR-004">
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={item.current ? 'page' : undefined}>
          <span class="term">{item.term}</span>
          <span class="subtitle">{item.subtitle}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* 004:T013 Every section stays visible on phones; nothing hides off-screen.
     006:T006 Phones: a compact two-column grid, so five sections still leave the
     identity card above the fold (001:SC-001). */
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-1) var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    flex-direction: column;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius);
    border: 1px solid transparent;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  a:hover {
    background: var(--color-surface-muted);
  }

  a[aria-current='page'] {
    background: var(--color-surface);
    border-color: var(--color-border);
    box-shadow: inset 3px 0 0 var(--color-accent);
  }

  .term {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* Tablets: one wrapping row */
  @media (min-width: 48rem) {
    ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    a {
      padding: var(--space-2) var(--space-3);
      line-height: 1.6;
    }
  }

  /* Desktop: sticky sidebar */
  @media (min-width: 64rem) {
    ul {
      flex-direction: column;
      flex-wrap: nowrap;
      position: sticky;
      top: var(--space-8);
    }
  }
</style>
