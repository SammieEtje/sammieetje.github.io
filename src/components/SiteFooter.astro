---
// 001:T027 Footer (001:FR-002); 001:T040 build identity, source and specs (001:FR-012)
import type { Locale } from '../i18n/ui.ts';
import { t } from '../i18n/utils.ts';
import { buildInfo, repoUrl, specsUrl } from '../site/build-info.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer data-spec="001:FR-012">
  <div class="inner">
    <p class="tagline">{t(locale, 'footer.tagline')}</p>
    <ul class="links mono">
      <li>
        <a href={buildInfo.url}>
          {t(locale, 'footer.build')} {buildInfo.shortSha}
        </a>
      </li>
      <li>
        <a href={repoUrl}>{t(locale, 'footer.source')}</a>
      </li>
      <li>
        <a href={specsUrl}>{t(locale, 'footer.specs')}</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    max-width: calc(var(--sidebar) + var(--content) + 3 * var(--gutter));
    margin: 0 auto;
    padding: var(--space-6) var(--gutter);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--color-text-muted);
  }

  .links a:hover {
    color: var(--color-accent);
  }
</style>
