---
// 002:T011 Key numbers card: value and label as one statement, context below (002:FR-004, 002:FR-006)
import type { Locale } from '../i18n/ui.ts';
import { t } from '../i18n/utils.ts';
import { formatNumber } from '../site/format.ts';
import { keyNumbers } from '../site/key-numbers.ts';
import PortalCard from './PortalCard.astro';

interface Props {
  locale: Locale;
  class?: string | undefined;
}

const { locale, class: className } = Astro.props;
---

<PortalCard
  id="numbers-title"
  title={t(locale, 'card.numbers.title')}
  kind={t(locale, 'card.numbers.kind')}
  spec="002:FR-004"
  class={className}
>
  <ul>
    {keyNumbers.map((n) => (
      <li data-spec="002:FR-006">
        <p>
          <strong class="value" data-spec="002:FR-005">
            {formatNumber(n.value, locale, n.suffix)}
          </strong>{' '}
          <span class="label">{n.label[locale]}</span>
        </p>
        <p class="context mono">{n.context[locale]}</p>
      </li>
    ))}
  </ul>
</PortalCard>

<style>
  ul {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-accent);
  }

  li + li {
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
  }

  .value {
    display: block;
    font-size: var(--text-xl);
    font-weight: 750;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .label {
    font-size: var(--text-sm);
  }

  .context {
    color: var(--color-text-muted);
  }
</style>
