---
// 003:T007 Career as a release log, newest first (003:FR-001 – 003:FR-006)
import type { Locale } from '../i18n/ui.ts';
import { t } from '../i18n/utils.ts';
import { releases } from '../site/career.ts';
import { formatPoint, releaseLabel } from '../site/period.ts';
import { patterns } from '../site/patterns.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<ol class="releases" data-spec="003:FR-001">
  {releases.map((r) => (
    <li
      id={`release-${r.id}`}
      data-release={r.id}
      class:list={[r.kind, { current: r.end === null }]}
      data-spec={r.kind === 'education' ? '003:FR-006' : '003:FR-002'}
    >
      <article aria-labelledby={`r-${r.id}`}>
        <p class="label mono">
          {r.kind === 'education' ? (
            <span class="chip">{t(locale, 'release.education')}</span>
          ) : (
            <span class="chip" data-spec="003:FR-003">
              {releaseLabel(r.start)}
            </span>
          )}
          {r.end === null && (
            <span class="chip latest" data-spec="003:FR-004">
              {t(locale, 'release.latest')}
            </span>
          )}
        </p>
        <h2 id={`r-${r.id}`}>{r.title[locale]}</h2>
        <p class="meta">
          {r.org[locale]} · {r.location} ·{' '}
          <time datetime={r.start}>{formatPoint(r.start, locale)}</time> –{' '}
          {r.end === null ? (
            t(locale, 'release.present')
          ) : (
            <time datetime={r.end}>{formatPoint(r.end, locale)}</time>
          )}
        </p>
        <p class="summary">{r.summary[locale]}</p>
        {r.patterns.length > 0 && (
          // 003:T009 Pattern tags, named as in the legend (003:FR-007)
          <ul class="patterns mono" aria-label={t(locale, 'release.patterns')}>
            {r.patterns.map((id) => (
              <li class={`tag tag-${id}`}>{patterns.find((p) => p.id === id)!.name[locale]}</li>
            ))}
          </ul>
        )}
        {r.notes && (
          <details data-spec="003:FR-005">
            <summary>
              {t(locale, 'release.notes')}
              <span class="visually-hidden">: {r.title[locale]}</span>
            </summary>
            <div class="notes">
              <h3>{t(locale, 'release.context')}</h3>
              <p>{r.notes[locale].context}</p>
              <h3>{t(locale, 'release.approach')}</h3>
              <p>{r.notes[locale].approach}</p>
              <h3>{t(locale, 'release.result')}</h3>
              <p>{r.notes[locale].result}</p>
            </div>
          </details>
        )}
      </article>
    </li>
  ))}
</ol>

<style>
  .releases {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0 0 0 var(--space-8);
    list-style: none;
  }

  /* The timeline rail */
  .releases::before {
    content: '';
    position: absolute;
    top: var(--space-2);
    bottom: var(--space-2);
    left: 0.6875rem;
    width: 2px;
    background: var(--color-border);
  }

  .releases > li {
    position: relative;
    /* 004:T007 Stable anchors: keep a linked release clear of the top edge (004:FR-007) */
    scroll-margin-top: var(--space-8);
  }

  .releases > li:target article {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* The commit dot: release items only, never the tag list items inside */
  .releases > li::before {
    content: '';
    position: absolute;
    top: 1.65rem;
    left: calc(-1 * var(--space-8) + 0.375rem);
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2px solid var(--color-text-muted);
  }

  .releases > li.current::before {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .releases > li.education::before {
    border-radius: 2px;
  }

  article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    min-width: 0;
    overflow-wrap: break-word;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) * 2);
  }

  li.current article {
    border-top: 4px solid var(--color-accent);
  }

  li.education article {
    background: var(--color-surface-muted);
    border-style: dashed;
  }

  .label {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  .latest {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  h2 {
    font-size: var(--text-lg);
  }

  .meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .patterns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    padding: 0 var(--space-2);
    border-radius: var(--radius);
    background: var(--color-surface-muted);
    color: var(--color-text-muted);
  }

  details {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-2);
  }

  summary {
    cursor: pointer;
    width: fit-content;
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .notes {
    display: grid;
    gap: var(--space-1);
    padding-top: var(--space-3);
    max-width: 68ch;
  }

  h3 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  h3:not(:first-child) {
    margin-top: var(--space-2);
  }

  @media (min-width: 48rem) {
    article {
      padding: var(--space-4) var(--space-6);
    }
  }

  @media print {
    details > :not(summary) {
      display: block;
    }
  }
</style>
