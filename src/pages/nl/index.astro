---
// 001:T032 Dutch home page (001:FR-007)
import PortalLayout from '../../layouts/PortalLayout.astro';
// 002:T017 The home page is the entity overview (002:FR-009)
import Overview from '../../components/Overview.astro';
import { routes } from '../../site/routes.ts';
import { routeMeta } from '../../site/meta.ts';

const route = routes[0]!;
const locale = 'nl';
---

<PortalLayout locale={locale} path={route.paths[locale]} meta={routeMeta(route, locale)}>
  <Overview locale={locale} />
</PortalLayout>
