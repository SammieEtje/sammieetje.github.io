{
  "name": "sammieetje-github-io",
  "version": "0.1.0",
  "private": true,
  "description": "Sander Ettema's profile site: a developer portal built spec-first and shipped through a quality gate.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test:unit": "vitest run",
    "trace": "node scripts/trace-check.ts",
    "test:e2e": "playwright test",
    "links": "linkinator ./dist --recurse --check-fragments --skip \"^https?://(?!localhost|127\\.0\\.0\\.1)\"",
    "budgets": "lhci collect && lhci upload && node scripts/quality-report.ts && lhci assert",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run trace && npm run build && npm run test:e2e && npm run links && npm run budgets"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@fontsource/inter": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "linkinator": "8.1.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "satori": "0.47.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
